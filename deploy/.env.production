# ╔══════════════════════════════════════════════════════════╗
# ║          LinScio MedComm SaaS 生产环境配置              ║
# ║  部署前必须填写所有标记 [必填] 的项                      ║
# ╚══════════════════════════════════════════════════════════╝

# ── 基础 ──────────────────────────────────────────────────
DEPLOYMENT_MODE=saas
DEBUG=0

# ── 数据库 & Redis ───────────────────────────────────────
# Docker 部署：由 docker-compose.yml 的 environment 块自动注入，无需在此设置
# 非 Docker 部署：取消注释并填写
# DATABASE_URL=postgresql+asyncpg://medcomm:密码@127.0.0.1:5432/medcomm
# REDIS_URL=redis://:密码@127.0.0.1:6379/0

# ── JWT [必填] ───────────────────────────────────────────
# 生成方法: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<替换为至少32字节的随机字符串>
JWT_ALGORITHM=HS256

# ── 腾讯云 COS [必填] ───────────────────────────────────
COS_SECRET_ID=<你的COS SecretId>
COS_SECRET_KEY=<你的COS SecretKey>
COS_REGION=ap-shanghai
COS_BUCKET_RELEASES=linscio-releases-1363203425
COS_BUCKET_MANIFEST=linscio-specialties-1363203425

# ── CDN ──────────────────────────────────────────────────
CDN_DOMAIN_RELEASES=releases.linscio.com
CDN_AUTH_SECRET=<CDN鉴权密钥>

# ── LLM API Keys [至少配置一个] ─────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# 第三方 OpenAI 兼容代理（如 GPTsAPI / One-API / OpenRouter 自建）
# 用法：把 OPENAI_API_KEY 和 OPENAI_BASE_URL 替换为代理的 key 和 base_url
# 同一个 key + base_url 通常可同时承载 GPT / Gemini / Claude，无需分别配
# 示例（同时调 GPT 和 Gemini 走 GPTsAPI）：
#   OPENAI_API_KEY=sk-gptsapi-xxx
#   OPENAI_BASE_URL=https://api.gptsapi.net/v1
#   GOOGLE_API_KEY=sk-gptsapi-xxx
#   GOOGLE_BASE_URL=https://api.gptsapi.net/v1
# 注意：GOOGLE_BASE_URL 必须改，否则 gemini-* 模型仍打 generativelanguage.googleapis.com

# ── 画图 API Keys [至少配置一个] ──────────────────────────

# GPT Image — 高质量，推荐生产使用
# 与文本 LLM 共用同一个 Key 时只需设 GPT_IMAGE_MODEL 即可
# 若使用独立的图像 API 代理，可单独设置 GPT_IMAGE_API_KEY 和 BASE_URL
GPT_IMAGE_API_KEY=
# 留空则沿用 OPENAI_BASE_URL；如使用第三方代理，请填写 base_url 根路径
# 例如：https://api.gptsapi.net/v1（SDK 会自动追加 /images/generations）
GPT_IMAGE_BASE_URL=
GPT_IMAGE_MODEL=gpt-image-2-plus

# 硅基流动 — 性价比高，推荐作为降级备选
# 可选：Kwai-Kolors/Kolors（快手可图）、Qwen/Qwen-Image（通义万相 200B）
SILICONFLOW_API_KEY=
SILICONFLOW_IMAGE_MODEL=Kwai-Kolors/Kolors

# 通义万相（阿里云 DashScope）— wanx2.1-t2i-turbo
DASHSCOPE_API_KEY=

# Midjourney — 需要代理服务（midjourney-proxy / GoAPI）
MIDJOURNEY_PROXY_URL=
MIDJOURNEY_API_SECRET=

# 可灵 AI — 异步任务 + JWT 鉴权（kling-v1 / v1-5 / v2 / v2-1）
# 仅在前端/参数显式选择 preferred_provider="kling" 时调用，避免误触发计费
# 鉴权二选一：
#   方式 A（官方主推）：填 ACCESS_KEY + SECRET_KEY，运行时自动签发 JWT
#   方式 B（聚合代理）：填 KLING_AI_API_KEY 走 Bearer Token
# 同时配置时优先 JWT，JWT 失败回退 Bearer
KLING_AI_ACCESS_KEY=
KLING_AI_SECRET_KEY=
KLING_AI_API_KEY=
# 国内主入口 https://api-beijing.klingai.com（默认）；国际 https://api.klingai.com
KLING_AI_BASE_URL=https://api-beijing.klingai.com
# 模型：kling-v1-5（成熟）/ kling-v2 / kling-v2-1（最新，价高）
KLING_AI_MODEL=kling-v1-5
# 清晰度：1k（标清，便宜）/ 2k（高清）
KLING_AI_RESOLUTION=1k

# 即梦 AI（火山引擎 Seedream）— 异步任务 + 火山 V4 签名鉴权
# 仅在前端/参数显式选择 preferred_provider="jimeng" 时调用
# 凭据来源：火山引擎控制台 → IAM → 密钥管理（AccessKey ID + AccessKey Secret）
VOLCENGINE_AK=
VOLCENGINE_SK=
# 模型 req_key：3.0=high_aes_general_v30l_zt2i（默认，海报强）
#               3.1=更高质量（具体 req_key 以火山控制台为准）
JIMENG_REQ_KEY=high_aes_general_v30l_zt2i
# 图生图 / 角色一致性 req_key（仅故事板模式 / 视觉锚点链路使用）
# 可选：
#   high_aes_ip_v20  — 角色 IP 保持（默认，最适合多张图人物一致）
#   jimeng_i2i_v30   — 即梦图生图 3.0 通用
#   byteedit_v2.0    — 智能编辑（局部参考）
# ⚠️ 该 req_key 在火山控制台需单独开通（默认只开 t2i）
# 留空使用代码默认值 high_aes_ip_v20
JIMENG_I2I_REQ_KEY=
# 文本扩写（默认关，避免与 medcomm 自身 prompt 构建逻辑冲突）
JIMENG_USE_PRE_LLM=false
# 文本影响程度（1-10），默认 2.5
JIMENG_SCALE=2.5

# ComfyUI Cloud — 自定义工作流
# COMFY_CLOUD_API_KEY=
# COMFYUI_WORKFLOW_JSON=

# ── 支付（易支付）[必填] ────────────────────────────────
YIPAY_PID=
YIPAY_KEY=
YIPAY_GATEWAY=https://zpayz.cn
YIPAY_NOTIFY_URL=https://www.linscio.com/api/v1/payment/notify
YIPAY_RETURN_URL=https://www.linscio.com/settings

# ── 桌面端远程认证 ──────────────────────────────────────
SAAS_API_URL=https://www.linscio.com

# ── NCBI（文献检索）────────────────────────────────────
LINSCIO_NCBI_API_KEY=

# ── 内部调试接口鉴权 ────────────────────────────────────
# /sections/{id}/generate-full 等无计费的全流程接口仅供内部调试使用，
# 必须通过 X-Internal-API header + 此 secret 才能调用。留空则接口直接 404。
# 生产环境强烈建议留空（不开放此接口）；如需排障，临时填入随机长字符串。
INTERNAL_API_SECRET=

# ── 可观测性（可选）────────────────────────────────────
SENTRY_DSN=
ALERT_WECHAT_WEBHOOK=
